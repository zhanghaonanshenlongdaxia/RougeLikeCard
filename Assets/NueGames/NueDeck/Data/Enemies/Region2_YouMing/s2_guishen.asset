  enemyDescription: "\u5E7D\u51A5\u754C\u7684\u81F3\u9AD8\u5B58\u5728\u2014\u2014\u9B3C\u795E\u3002\u4F20\u8BF4\u4E2D\u4FEE\u70BC\u4E07\u5E74\u6210\u795E\u7684\u5B58\u5728\u3002\u4E09\u9636\u6BB5\u4ECE\u7A33\u5065\u5230\u672B\u65E5\u7206\u53D1\u3002"
