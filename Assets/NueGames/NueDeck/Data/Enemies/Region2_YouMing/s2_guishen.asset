  encounterDialogue: "\uFF08\u51A5\u754C\u9707\u52A8\uFF0C\u9B3C\u795E\u964D\u4E34\uFF09\n\u51E1\u4EBA\u2026\u2026\n\u4F60\u7ADF\u6562\u2026\u2026\u8E0F\u5165\u9B3C\u795E\u4E4B\u57DF\u2026\u2026\n\u672C\u795E\u4FEE\u70BC\u4E07\u5E74\u2026\u2026\n\u89C1\u8BC1\u8FC7\u65E0\u6570\u82F1\u96C4\u7684\u9668\u843D\u2026\u2026\n\u4F60\u2026\u2026\u4E0D\u8FC7\u662F\u53C8\u4E00\u4E2A\u8FC7\u5BA2\u3002"
  victoryDialogue: "\u4E07\u2026\u2026\u4E07\u5E74\u4FEE\u4E3A\u2026\u2026\n\u672C\u795E\u2026\u2026\u7ADF\u8D25\u4E8E\u51E1\u4EBA\u4E4B\u624B\u2026\u2026\n\u770B\u6765\u2026\u2026\u8FD9\u5E7D\u51A5\u2026\u2026\n\u5DF2\u7ECF\u4E0D\u9700\u8981\u9B3C\u795E\u4E86\u2026\u2026\n\u4F60\u7684\u8DEF\u2026\u2026\u8FD8\u5F88\u6F2B\u957F\u2026\u2026\n\u524D\u65B9\u2026\u2026\u6709\u66F4\u6050\u6016\u7684\u5B58\u5728\u2026\u2026\u5728\u7B49\u7740\u4F60\u2026\u2026\n\uFF08\u9B3C\u795E\u5316\u4E3A\u6EE1\u5929\u661F\u8F89\uFF0C\u7F13\u7F13\u6D88\u6563\u4E8E\u51A5\u96FE\u4E2D\uFF09"
