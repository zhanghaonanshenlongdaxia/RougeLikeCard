  encounterDialogue: "\u5475\u5475\u5475\u2026\u2026\n\u4F60\u7ADF\u8D70\u5230\u4E86\u8FD9\u91CC\u2026\u2026\n\u672C\u7956\u4FEE\u70BC\u4E07\u86CA\u4E4B\u672F\u5343\u5E74\u2026\u2026\n\u89C1\u8FC7\u4F60\u8FD9\u79CD\u4E0D\u77E5\u5929\u9AD8\u5730\u539A\u7684\u5E74\u8F7B\u4EBA\u2026\u2026\u592A\u591A\u4E86\u2026\u2026\n\u4ED6\u4EEC\u7684\u767D\u9AA8\u2026\u2026\u5C31\u5728\u672C\u7956\u811A\u4E0B\u2026\u2026\n\u4F60\u2026\u2026\u4E5F\u4F1A\u662F\u4E00\u6837\u7684\u4E0B\u573A\uFF01"
  victoryDialogue: "\u5343\u5E74\u2026\u2026\n\u672C\u7956\u7684\u86CA\u672F\u2026\u2026\n\u7ADF\u8D25\u5728\u4F60\u624B\u4E2D\u2026\u2026\n\u770B\u6765\u2026\u2026\u8FD9\u5E7D\u51A5\u79D8\u5883\u2026\u2026\u4E0D\u518D\u9700\u8981\u8001\u7956\u4E86\u2026\u2026\n\u53BB\u5427\u2026\u2026\u53BB\u9762\u5BF9\u66F4\u5927\u7684\u6050\u6016\u2026\u2026\n\uFF08\u4E07\u86CA\u8001\u7956\u5316\u4E3A\u86CA\u58F3\u788E\u88C2\uFF09"
