  victoryDialogue: "\u4E07\u5E74\u2026\u2026\n\u672C\u738B\u2026\u2026\u7ADF\u4E5F\u8D25\u4E86\u2026\u2026\n\u770B\u6765\u2026\u2026\u5E7D\u51A5\u2026\u2026\u4E5F\u9700\u8981\u65B0\u7684\u4E3B\u4EBA\u4E86\u2026\u2026\n\u53BB\u5427\u2026\u2026\u4F60\u7684\u8DEF\u2026\u2026\u8FD8\u5F88\u957F\u2026\u2026\n\uFF08\u5E7D\u51A5\u738B\u5316\u4E3A\u51A5\u96FE\uFF0C\u6E10\u6E10\u6D88\u6563\u4E8E\u5929\u5730\u95F4\uFF09"
