  enemyDescription: "\u4E07\u86CA\u6CBC\u6CFD\u7684\u521B\u4E16\u8005\u3002\u4E07\u6BD2\u4E4B\u9053\u7684\u5F00\u521B\u8005\uFF0C\u4F20\u8BF4\u4E2D\u7B2C\u4E00\u4E2A\u4EE5\u6BD2\u5165\u9053\u7684\u4FEE\u58EB\u3002\u4E09\u9636\u6BB5\u4ECE\u94FA\u57AB\u5230\u6781\u9650\u3002"
  enemyPortrait: {fileID: 0}
  encounterDialogue: "\uFF08\u5929\u5730\u53D8\u8272\uFF0C\u4E07\u6BD2\u8001\u7956\u4ECE\u6CBC\u6CFD\u6DF1\u5904\u8D70\u51FA\uFF09\n\u4F60\u2026\u2026\u7EC8\u4E8E\u6765\u4E86\u2026\u2026\n\u672C\u7956\u5F00\u521B\u4E07\u6BD2\u4E4B\u9053\u2026\u2026\u5DF2\u903E\u4E07\u5E74\u2026\u2026\n\u89C1\u8FC7\u592A\u591A\u82F1\u96C4\u8C6A\u6770\u2026\u2026\n\u4ED6\u4EEC\u90FD\u5316\u4E3A\u4E86\u672C\u7956\u811A\u4E0B\u7684\u6BD2\u6CE5\u2026\u2026\n\u4F60\u2026\u2026\u4E5F\u4F1A\u662F\u4E00\u6837\u2026\u2026\n\uFF08\u4E07\u6BD2\u8001\u7956\u4E00\u6325\u624B\uFF0C\u6CBC\u6CFD\u6CB8\u817E\uFF09"
  victoryDialogue: "\u4E07\u2026\u2026\u4E07\u5E74\u6BD2\u9053\u2026\u2026\n\u672C\u7956\u2026\u2026\u5F00\u521B\u4E86\u4E00\u5207\u2026\u2026\n\u7ADF\u8D25\u5728\u4F60\u624B\u4E2D\u2026\u2026\n\u770B\u6765\u2026\u2026\u6BD2\u9053\u2026\u2026\u4E5F\u6709\u7EC8\u70B9\u2026\u2026\n\u53BB\u5427\u2026\u2026\u6700\u540E\u7684\u8BD5\u70BC\u2026\u2026\u5728\u5929\u9B54\u88C2\u9699\u7B49\u7740\u4F60\u2026\u2026\n\uFF08\u4E07\u6BD2\u8001\u7956\u5316\u4E3A\u4E07\u5343\u6BD2\u86C7\u6D88\u6563\uFF09"
