  enemyDescription: "\u7EDF\u9886\u5C71\u91CE\u5996\u517D\u7684\u5996\u5C06\uFF0C\u4FEE\u70BC\u4E09\u767E\u5E74\u3002\u5584\u7528\u53CC\u5200\uFF0C\u653B\u5B88\u517C\u5907\u3002\u8840\u91CF\u8FC7\u534A\u540E\u4F1A\u8FDB\u5165\u72C2\u66B4\u72B6\u6001\uFF0C\u653E\u5F03\u9632\u5B88\u5168\u529B\u8F93\u51FA\u3002"
  enemyPortrait: {fileID: 0}
  encounterDialogue: "\u5C14\u7B49\u51E1\u4EBA\uFF0C\u7ADF\u6562\u95EF\u5165\u672C\u5C06\u9886\u5730\uFF01\n\u4ECA\u65E5\u4FBF\u8BA9\u4F60\u77E5\u9053\u4F55\u4E3A\u5929\u9AD8\u5730\u539A\uFF01\n\uFF08\u5996\u5C06\u62D4\u51FA\u53CC\u5200\uFF0C\u5996\u6C14\u51B2\u5929\uFF09"
  victoryDialogue: "\u54B3\u2026\u2026\u54B3\u2026\u2026\n\u6CA1\u60F3\u5230\u2026\u2026\u672C\u5C06\u4FEE\u70BC\u4E09\u767E\u5E74\u2026\u2026\n\u7ADF\u8D25\u5728\u4F60\u624B\u4E2D\u2026\u2026\n\u7F62\u4E86\uFF0C\u7F62\u4E86\u2026\u2026"
