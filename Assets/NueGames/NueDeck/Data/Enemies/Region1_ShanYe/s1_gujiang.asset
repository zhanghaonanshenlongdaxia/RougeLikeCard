  enemyDescription: "\u6B7B\u4E0D\u7791\u76EE\u7684\u9B3C\u5C06\uFF0C\u4EE5\u6267\u5FF5\u5316\u5F62\u3002\u751F\u524D\u5584\u7528\u957F\u67AA\uFF0C\u6B7B\u540E\u67AA\u6CD5\u66F4\u80DC\u3002\u8840\u91CF\u516D\u6210\u540E\u4F7F\u51FA\u6B7B\u4EA1\u8FDE\u51FB\u3002"
