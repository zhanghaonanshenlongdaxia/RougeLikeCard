  encounterDialogue: "\u54C8\u54C8\u54C8\u2014\u2014\uFF01\n\u6765\u8005\u4F55\u4EBA\uFF1F\u7ADF\u6562\u95EF\u5165\u6211\u9ED1\u98CE\u5CAD\uFF01\n\u672C\u5927\u5723\u5728\u6B64\u4FEE\u70BC\u5343\u5E74\uFF0C\u4F55\u4EBA\u6562\u6765\u9001\u6B7B\uFF1F\n\u4F60\uFF1F\u4E00\u4E2A\u6BDB\u5934\u5C0F\u5B50\uFF1F\n\u4E5F\u7F62\uFF0C\u8BA9\u6211\u770B\u770B\u4F60\u6709\u4EC0\u4E48\u672C\u4E8B\uFF01\n\uFF08\u9ED1\u98CE\u5927\u5723\u53CC\u638C\u4E00\u5408\uFF0C\u5996\u6C14\u51B2\u5929\uFF0C\u5730\u9762\u9F9F\u88C2\uFF09"
  victoryDialogue: "\u54B3\u2026\u2026\u54B3\u54B3\u2026\u2026\n\u5343\u5E74\u2026\u2026\u5343\u5E74\u4FEE\u4E3A\u2026\u2026\n\u7ADF\u8D25\u5728\u4F60\u624B\u4E2D\u2026\u2026\n\u4E5F\u7F62\u2026\u2026\u4E5F\u7F62\u2026\u2026\n\u9ED1\u98CE\u5CAD\u2026\u2026\u4ECA\u65E5\u4FBF\u4EA4\u4E8E\u4F60\u4E86\u2026\u2026\n\uFF08\u9ED1\u98CE\u5927\u5723\u5316\u4E3A\u4E00\u9053\u9ED1\u5149\u6D88\u6563\uFF09"
