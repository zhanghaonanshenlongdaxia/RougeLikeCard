  enemyDescription: "\u5360\u636E\u9ED1\u98CE\u5CAD\u5343\u5E74\u7684\u5996\u738B\uFF0C\u81EA\u79F0\u9ED1\u98CE\u5927\u5723\u3002\u672C\u4F53\u662F\u4E00\u53EA\u4FEE\u70BC\u5343\u5E74\u7684\u9ED1\u718A\u7CBE\uFF0C\u5B9E\u529B\u6DF1\u4E0D\u53EF\u6D4B\u3002\u4E09\u9636\u6BB5\uFF1A\u7A33\u624E\u7A33\u6253\u2192\u72C2\u66B4\u56DE\u8840\u2192\u672B\u65E5\u7206\u53D1\u3002"
